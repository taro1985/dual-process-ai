# Dual-Process AI - Environment Variables
# Copy this file to .env and fill in your keys.

# Required: Google Gemini API Key (for System 2 reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: TypeSafe Jev API Key (for enhanced System 1 classification)
# Without this, the router uses a fast keyword-based fallback.
# Get your key at: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional: Discord Bot Token (for discord_bot.py)
DISCORD_BOT_TOKEN=
